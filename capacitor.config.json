{
  "appId": "com.admeve.rahbandoon",
  "appName": "راه‌بندون",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 84,
    "errorPath": "webview-update.html"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#101c30",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_rb",
      "iconColor": "#F2B124"
    }
  },
  "backgroundColor": "#101c30"
}

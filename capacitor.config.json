{
  "appId": "com.admeve.zendegi",
  "appName": "زندگی ایرونی",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
